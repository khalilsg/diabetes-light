# Copy to diabetes_light.env and fill in. That file is gitignored.
#
# Comments work after whitespace-then-#. A '#' with no space before it is kept,
# so p@ss#word is fine unquoted. Quote the value to preserve it verbatim.

# --- Dexcom -----------------------------------------------------------------
# Your Dexcom USERNAME, not your email address. These are usually different.
# Must be the wearer's account, not a follower's.
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_REGION=us          # us | ous | jp

# --- Hue --------------------------------------------------------------------
# Run --pair to generate the key, then --list-lights to find the ids.
HUE_BRIDGE_IP=
HUE_APP_KEY=
HUE_LIGHT_IDS=            # one id, or several separated by commas

# Rooms. Use this INSTEAD of HUE_LIGHT_IDS when you want different lights at
# different brightness — one line, JSON. Every group shows the same colour at
# the same time; what a group sets is how bright its room is about it.
# Anything a group leaves out falls back to the settings below, so the second
# and third here just inherit them. A light belongs to one group only.
# HUE_LIGHT_GROUPS={"bedroom":{"lights":["id-a"],"max":25,"min":3,"urgent_level":60},"kitchen":{"lights":["id-b","id-c"],"max":95},"office":["id-d"]}

# --- Optional ---------------------------------------------------------------
# Colours. Defaults live at the top of diabetes_light.py; setting this here
# means a script update can't overwrite your palette.
# COLOR_STOPS=[[55,"#FF00A8"],[70,"#FF0033"],[90,"#FF4D00"],[115,"#FF9500"],[145,"#FFC400"],[175,"#FFE0A0"],[200,"#FFFFFF"],[250,"#00D0FF"]]

# Trend adjustment. The reading is shifted by its Dexcom arrow before the
# colour and brightness level are picked, so the light leans toward where you're
# heading. Set TREND_ADJUST=0 to switch it off; override TREND_OFFSETS to retune
# it (one line, JSON, same units as COLOR_STOPS). Note that a falling arrow can
# push a reading under URGENT_BELOW.
# TREND_ADJUST=1
# TREND_OFFSETS={"DoubleUp":15,"SingleUp":10,"FortyFiveUp":5,"Flat":0,"FortyFiveDown":-5,"SingleDown":-10,"DoubleDown":-15}

# Brightness, 1-100. These are the defaults for every light; the first, second
# and fourth can be set per room in HUE_LIGHT_GROUPS above.
# MAX_BRIGHTNESS=70
# MIN_BRIGHTNESS=10
# URGENT_BELOW=70         # at or under this reading, jump to URGENT_LEVEL
# URGENT_LEVEL=100

# Timing, in minutes. Shared by every light — a reading is stale everywhere at
# once. STALE_MINUTES must stay below WATCHDOG_MINUTES.
# FRESH_MINUTES=6
# STALE_MINUTES=13
# WATCHDOG=1
# WATCHDOG_MINUTES=15
# POLL_SECONDS=60

# Status page: the log line as a web page, plus recent history and warnings.
# 0 is off. Listens on 127.0.0.1 only; see README section 7a for reaching it
# over HTTPS from a phone with `tailscale serve`.
# STATUS_PORT=8768
