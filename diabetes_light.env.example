# Copy to diabetes_light.env and fill in. That file is gitignored.
#
# Comments work after whitespace-then-#. A '#' with no space before it is kept,
# so p@ss#word is fine unquoted. Quote the value to preserve it verbatim.

# --- Dexcom -----------------------------------------------------------------
# Your Dexcom USERNAME, not your email address. These are usually different.
# Must be the wearer's account, not a follower's.
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_REGION=us          # us | ous | jp

# --- Hue --------------------------------------------------------------------
# Run --pair to generate the key, then --list-lights to find the ids.
HUE_BRIDGE_IP=
HUE_APP_KEY=
HUE_LIGHT_IDS=            # one id, or several separated by commas

# --- Optional ---------------------------------------------------------------
# Colours. Defaults live at the top of diabetes_light.py; setting this here
# means a script update can't overwrite your palette.
# COLOR_STOPS=[[55,"#FF00A8"],[70,"#FF0033"],[90,"#FF4D00"],[115,"#FF9500"],[145,"#FFC400"],[175,"#FFE0A0"],[200,"#FFFFFF"],[250,"#00D0FF"]]

# Brightness, 1-100.
# MAX_BRIGHTNESS=70
# MIN_BRIGHTNESS=10
# URGENT_BELOW=70         # at or under this reading, jump to URGENT_LEVEL
# URGENT_LEVEL=100

# Timing, in minutes. STALE_MINUTES must stay below WATCHDOG_MINUTES.
# FRESH_MINUTES=6
# STALE_MINUTES=13
# WATCHDOG=1
# WATCHDOG_MINUTES=15
# POLL_SECONDS=60
